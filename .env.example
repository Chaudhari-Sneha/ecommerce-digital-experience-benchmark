# Copy this file to .env and fill in your own values.
# .env is git-ignored: never commit real credentials.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=digital_friction
DB_USER=postgres
DB_PASSWORD=

# Free key: enable the "PageSpeed Insights API" in a Google Cloud project, then
# create an API key at https://console.cloud.google.com/apis/credentials
# No billing account is needed.
PAGESPEED_API_KEY=
